[build-system]
requires = ["setuptools>=45", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "multi-agent-release-notes"
version = "0.3.0"
description = "Multi-agent release notes generator with async, retries, logging, and Confluence support"
authors = [{name = "AI Team", email = "ai-team@example.com"}]
dependencies = [
    "aiohttp>=3.9.0",
    "openai>=1.0.0",
    "anthropic>=0.28.0",
    "google-generativeai>=0.3.0",
    "pydantic>=2.0.0",
    "tenacity>=8.0.0",
    "structlog>=23.0.0",
    "python-dotenv>=1.0.0",
    "click>=8.0.0",
]
requires-python = ">=3.10"
classifiers = [
    "Programming Language :: Python :: 3",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
]

[project.scripts]
generate-release-notes = "main:main"

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-asyncio>=0.21.0",
    "pytest-mock>=3.0.0",
]
confluence = [
    "atlassian-python-api>=3.41.0",
]

[tool.setuptools]
package-dir = {"" = "src"}
packages = [""]

[tool.setuptools.package-data]
"*" = ["*.py"]
